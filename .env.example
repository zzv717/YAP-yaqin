# Copy to .env.local only for local development. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
MERCHANT_PANEL_PASSWORD=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=from-vercel-blob-storage
# Optional: sends new reservations to a Telegram admin chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
